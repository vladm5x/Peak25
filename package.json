{
  "name": "peak-25-challenge",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel --go --clear",
    "start:lan": "expo start --lan --go",
    "sync": "node scripts/sync-server.cjs",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist-web",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:production": "eas build --platform ios --profile production",
    "icons:pwa": "node scripts/generate-pwa-icons.cjs",
    "import:sheet": "node scripts/import-google-sheet.cjs",
    "test": "tsx src/data.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.19",
    "expo-haptics": "^57.0.2",
    "expo-image-picker": "~57.0.16",
    "expo-status-bar": "^57.0.1",
    "lucide-react-native": "^1.40.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "eas-cli": "^23.2.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.2"
  }
}
